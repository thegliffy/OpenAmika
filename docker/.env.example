# Only used by the optional ollama-proxy service (docker compose --profile proxy up -d).
# The proxy translates Amika's Ollama-dialect calls to an OpenAI-dialect backend.
# The fork can also speak OpenAI directly (config/ollama.json: "dialect": "openai") —
# run the proxy only when you specifically want the Ollama-API surface.
OPENAI_API_BASE_URL=http://your-brain-host:8080/v1
OPENAI_API_KEY=***

# Inbound gate for the proxy itself (comma-separated list). The fork overlay enforces it;
# unset behaves like stock (wide open). Amika fills this in when you save a key in setup.
INBOUND_API_KEYS=

LOG_LEVEL=info
